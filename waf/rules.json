  {
    "Name": "refund-needs-admin-key",
    "Priority": 70,
    "Action": {
      "Block": {
        "CustomResponse": { "ResponseCode": 403, "CustomResponseBodyKey": "admin_required" }
      }
    },
    "Statement": {
      "AndStatement": {
        "Statements": [
          {
            "ByteMatchStatement": {
              "FieldToMatch": {
                "JsonBody": {
                  "MatchPattern": { "IncludedPaths": ["/method"] },
                  "MatchScope": "VALUE",
                  "InvalidFallbackBehavior": "MATCH",
                  "OversizeHandling": "MATCH"
                }
              },
              "PositionalConstraint": "EXACTLY",
              "SearchString": "tools/call",
              "TextTransformations": [{ "Priority": 0, "Type": "NONE" }]
            }
          },
          {
            "ByteMatchStatement": {
              "FieldToMatch": {
                "JsonBody": {
                  "MatchPattern": { "IncludedPaths": ["/params/name"] },
                  "MatchScope": "VALUE",
                  "InvalidFallbackBehavior": "MATCH",
                  "OversizeHandling": "MATCH"
                }
              },
              "PositionalConstraint": "EXACTLY",
              "SearchString": "refund_payment",
              "TextTransformations": [{ "Priority": 0, "Type": "NONE" }]
            }
          },
          {
            "NotStatement": {
              "Statement": {
                "ByteMatchStatement": {
                  "FieldToMatch": { "SingleHeader": { "Name": "x-admin-key" } },
                  "PositionalConstraint": "EXACTLY",
                  "SearchString": "{{ADMIN_KEY}}",
                  "TextTransformations": [{ "Priority": 0, "Type": "NONE" }]
                }
              }
            }
          }
        ]
      }
    },
    "VisibilityConfig": {
      "SampledRequestsEnabled": true,
      "CloudWatchMetricsEnabled": true,
      "MetricName": "refund-needs-admin-key"
    }
  }
]
